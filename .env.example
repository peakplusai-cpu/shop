STOREFRONT_SUPABASE_URL=https://your-project-ref.supabase.co
STOREFRONT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_STOREFRONT_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_STOREFRONT_SUPABASE_ANON_KEY=your-anon-key

CREEM_API_KEY=creem_your-api-key
CREEM_WEBHOOK_SECRET=whsec_your-webhook-secret
CREEM_TEST_MODE=false

NEXT_PUBLIC_STOREFRONT_URL=https://your-shop-domain.com
NEXT_PUBLIC_STOREFRONT_BRAND=Your Maison
STOREFRONT_COMMERCIAL=true
STOREFRONT_ADMIN_PASSWORD=choose-at-least-16-characters
STOREFRONT_ADMIN_SECRET=generate-an-independent-random-secret
# Base32 seed added to an authenticator app; required on hosted deployments.
STOREFRONT_ADMIN_TOTP_SECRET=replace-with-generated-base32-secret
# Optional comma-separated public IP allowlist.
# STOREFRONT_ADMIN_ALLOWED_IPS=203.0.113.10

# CJ Dropshipping fulfillment. Prefer the API key so the server can obtain and
# cache an access token. Alternatively set CJ_ACCESS_TOKEN instead.
CJ_API_KEY=your-cj-api-key
# CJ_ACCESS_TOKEN=your-current-cj-access-token
CJ_SANDBOX=true
# Required in addition to CJ_SANDBOX=false before any real order can be sent.
CJ_PRODUCTION_ENABLED=false
CJ_FROM_COUNTRY_CODE=CN
CJ_DEFAULT_LOGISTIC_NAME=CJPacket Ordinary
# Optional; if set, it must exactly match an API store name in CJ.
# CJ_STORE_NAME=peak.shop
